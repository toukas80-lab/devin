{
  "schema_version": 1,
  "window": {
    "title_re": "SoftOne|Series 6|Νέα λειτουργική εφαρμογή βάσης",
    "class_name_re": "Chrome_WidgetWin_1"
  },
  "profiles": {
    "softone.login": {
      "operation": "login",
      "description": "Σύνδεση ή αναμονή μέχρι να είναι έτοιμο το SoftOne",
      "window": {
        "title_re": "SoftOne|Series 6|Νέα λειτουργική εφαρμογή βάσης",
        "class_name_re": "Chrome_WidgetWin_1"
      },
      "required_context": [],
      "steps": [
        {
          "id": "username",
          "action": "set",
          "optional": true,
          "skip_if_empty": true,
          "selector": {
            "control_type": "Edit",
            "anchor": {
              "direction": "right",
              "max_distance": 500,
              "selector": {
                "title_re": "Χρήστης|Username"
              }
            }
          },
          "value": "{username}"
        },
        {
          "id": "password",
          "action": "set",
          "optional": true,
          "skip_if_empty": true,
          "secret": true,
          "selector": {
            "control_type": "Edit",
            "anchor": {
              "direction": "right",
              "max_distance": 500,
              "selector": {
                "title_re": "Κωδικός|Password"
              }
            }
          },
          "value": "{password}",
          "submit_keys": "{ENTER}"
        },
        {
          "id": "softone-ready",
          "action": "wait_present",
          "selector": {
            "title_re": "Ειδικά πιστωτών|Αγορές|Πωλήσεις",
            "control_type": "Text"
          },
          "timeout_seconds": 60
        }
      ]
    },
    "creditor_expense.open_create": {
      "operation": "navigate",
      "description": "Μετάβαση στα Ειδικά πιστωτών και άνοιγμα Νέας Εγγραφής",
      "window": {
        "title_re": "SoftOne|Series 6|Νέα λειτουργική εφαρμογή βάσης",
        "class_name_re": "Chrome_WidgetWin_1"
      },
      "required_context": [],
      "steps": [
        {
          "id": "creditor-expenses",
          "action": "click",
          "optional": true,
          "selector": {
            "title_re": "Ειδικά πιστωτών",
            "control_type": "Text"
          }
        },
        {
          "id": "new-entry",
          "action": "click",
          "optional": true,
          "selector": {
            "title_re": "Νέα Εγγραφή|Νέα εγγραφή",
            "control_type": "Text"
          }
        },
        {
          "id": "new-form-ready",
          "action": "wait_present",
          "selector": {
            "title_re": "Νέα Εγγραφή",
            "control_type": "Text"
          },
          "timeout_seconds": 30
        }
      ]
    },
    "creditor_expense.create": {
      "operation": "create",
      "description": "Νέα εγγραφή στα Ειδικά πιστωτών",
      "required_context": [
        "series_code",
        "document_date",
        "document_number",
        "supplier_code",
        "line_code",
        "net_value",
        "payment_method"
      ],
      "steps": [
        {
          "id": "new-form-visible",
          "action": "assert",
          "selector": {
            "title_re": "Νέα Εγγραφή",
            "control_type": "Text"
          }
        },
        {
          "id": "series",
          "action": "set",
          "selector": {
            "control_type": "ComboBox",
            "anchor": {
              "direction": "right",
              "max_distance": 500,
              "selector": {
                "title": "Σειρά"
              }
            }
          },
          "value": "{series_code}",
          "submit_keys": "{ENTER}"
        },
        {
          "id": "date",
          "action": "set",
          "selector": {
            "control_type": "Edit",
            "anchor": {
              "direction": "right",
              "max_distance": 500,
              "selector": {
                "title_re": "Ημερ/νία|Ημερομηνία"
              }
            }
          },
          "value": "{document_date}"
        },
        {
          "id": "document-type",
          "action": "set",
          "skip_if_empty": true,
          "selector": {
            "control_type": "ComboBox",
            "anchor": {
              "direction": "right",
              "max_distance": 500,
              "selector": {
                "title": "Τύπος"
              }
            }
          },
          "value": "{document_type}",
          "submit_keys": "{ENTER}"
        },
        {
          "id": "company-branch",
          "action": "set",
          "skip_if_empty": true,
          "selector": {
            "control_type": "ComboBox",
            "anchor": {
              "direction": "right",
              "max_distance": 700,
              "selector": {
                "title_re": "Υποκατάστημα εταιρείας|Υποκ/μα εταιρείας"
              }
            }
          },
          "value": "{company_branch}",
          "submit_keys": "{ENTER}"
        },
        {
          "id": "supplier",
          "action": "set",
          "selector": {
            "control_type": "ComboBox",
            "anchor": {
              "direction": "right",
              "max_distance": 900,
              "selector": {
                "title_re": "Πιστωτής|Προμηθευτής"
              }
            }
          },
          "value": "{supplier_code}",
          "submit_keys": "{ENTER}"
        },
        {
          "id": "supplier-branch",
          "action": "set",
          "skip_if_empty": true,
          "selector": {
            "control_type": "ComboBox",
            "anchor": {
              "direction": "right",
              "max_distance": 700,
              "selector": {
                "title_re": "Υποκατάστημα προμηθευτή|Υποκ/μα προμηθευτή"
              }
            }
          },
          "value": "{supplier_branch}",
          "submit_keys": "{ENTER}"
        },
        {
          "id": "document-number",
          "action": "set",
          "selector": {
            "control_type": "Edit",
            "anchor": {
              "direction": "right",
              "max_distance": 600,
              "selector": {
                "title_re": "Παραστατικό|Αρ\\. παραστατικού"
              }
            }
          },
          "value": "{document_number}"
        },
        {
          "id": "payment",
          "action": "set",
          "selector": {
            "control_type": "ComboBox",
            "anchor": {
              "direction": "right",
              "max_distance": 700,
              "selector": {
                "title": "Πληρωμή"
              }
            }
          },
          "value": "{payment_method}",
          "submit_keys": "{ENTER}"
        },
        {
          "id": "warehouse",
          "action": "set",
          "skip_if_empty": true,
          "selector": {
            "control_type": "ComboBox",
            "anchor": {
              "direction": "right",
              "max_distance": 700,
              "selector": {
                "title_re": "Αποθηκευτικός χώρος|Α\\.Χ\\.|Αποθήκη"
              }
            }
          },
          "value": "{warehouse}",
          "submit_keys": "{ENTER}"
        },
        {
          "id": "vat-regime",
          "action": "set",
          "skip_if_empty": true,
          "selector": {
            "control_type": "ComboBox",
            "anchor": {
              "direction": "right",
              "max_distance": 700,
              "selector": {
                "title_re": "Καθεστώς Φ\\.?Π\\.?Α\\.?"
              }
            }
          },
          "value": "{vat_regime}",
          "submit_keys": "{ENTER}"
        },
        {
          "id": "line-code",
          "action": "grid_set",
          "grid": {
            "control_type": "DataGrid",
            "class_name_re": "x-grid"
          },
          "column": {
            "title": "Κωδικός",
            "control_type": "DataItem"
          },
          "value": "{line_code}",
          "submit_keys": "{ENTER}"
        },
        {
          "id": "quantity",
          "action": "grid_set",
          "grid": {
            "control_type": "DataGrid",
            "class_name_re": "x-grid"
          },
          "column": {
            "title_re": "Ποσότητα|Ποσ\\.",
            "control_type": "DataItem"
          },
          "value": "{quantity}"
        },
        {
          "id": "description",
          "action": "grid_set",
          "grid": {
            "control_type": "DataGrid",
            "class_name_re": "x-grid"
          },
          "column": {
            "title": "Περιγραφή",
            "control_type": "DataItem"
          },
          "value": "{description}"
        },
        {
          "id": "net-value",
          "action": "grid_set",
          "grid": {
            "control_type": "DataGrid",
            "class_name_re": "x-grid"
          },
          "column": {
            "title": "Αξία",
            "control_type": "DataItem"
          },
          "value": "{net_value}"
        },
        {
          "id": "discount",
          "action": "grid_set",
          "skip_if_empty": true,
          "grid": {
            "control_type": "DataGrid",
            "class_name_re": "x-grid"
          },
          "column": {
            "title_re": "Έκπτωση|Εκπτ\\.",
            "control_type": "DataItem"
          },
          "value": "{discount}"
        },
        {
          "id": "charges",
          "action": "set",
          "skip_if_empty": true,
          "selector": {
            "control_type": "Edit",
            "anchor": {
              "direction": "right",
              "max_distance": 600,
              "selector": {
                "title_re": "Έξοδα|Επιβαρύνσεις"
              }
            }
          },
          "value": "{charges}"
        },
        {
          "id": "withholding",
          "action": "set",
          "skip_if_empty": true,
          "selector": {
            "control_type": "Edit",
            "anchor": {
              "direction": "right",
              "max_distance": 600,
              "selector": {
                "title_re": "Παρακράτηση|Παρακρατήσεις"
              }
            }
          },
          "value": "{withholding}"
        },
        {
          "id": "comments",
          "action": "set",
          "skip_if_empty": true,
          "selector": {
            "control_type": "Edit",
            "anchor": {
              "direction": "right",
              "max_distance": 900,
              "selector": {
                "title_re": "Παρατηρήσεις|Σχόλια"
              }
            }
          },
          "value": "{comments}"
        },
        {
          "id": "no-validation-error",
          "action": "assert_absent",
          "selector": {
            "title_re": "Δεν έχετε συμπληρώσει|Ημερομηνία εκτός|Invalid value|Range Error|rollback|List index out of bounds",
            "control_type": "Text"
          },
          "timeout_seconds": 1
        },
        {
          "id": "save",
          "action": "save",
          "selector": {
            "title": "Καταχώρηση",
            "control_type": "Button"
          }
        },
        {
          "id": "settlement-confirm",
          "action": "click",
          "optional": true,
          "when": {
            "settlement_enabled": "true"
          },
          "timeout_seconds": 3,
          "selector": {
            "title_re": "Ναι|Καταχώρηση",
            "control_type": "Button",
            "anchor": {
              "direction": "below",
              "max_distance": 500,
              "selector": {
                "title_re": "Εξόφληση|εξοφλητικό"
              }
            }
          }
        },
        {
          "id": "print-accept",
          "action": "click",
          "optional": true,
          "when": {
            "print_policy": "accept"
          },
          "timeout_seconds": 3,
          "selector": {
            "title_re": "Ναι|Εκτύπωση",
            "control_type": "Button",
            "anchor": {
              "direction": "below",
              "max_distance": 500,
              "selector": {
                "title_re": "Εκτύπωση"
              }
            }
          }
        },
        {
          "id": "print-decline",
          "action": "click",
          "optional": true,
          "when": {
            "print_policy": "decline"
          },
          "timeout_seconds": 3,
          "selector": {
            "title_re": "Όχι|Ακύρωση",
            "control_type": "Button",
            "anchor": {
              "direction": "below",
              "max_distance": 500,
              "selector": {
                "title_re": "Εκτύπωση"
              }
            }
          }
        },
        {
          "id": "saved",
          "action": "wait_absent",
          "selector": {
            "title_re": "Νέα Εγγραφή",
            "control_type": "Text"
          },
          "timeout_seconds": 20
        }
      ]
    },
    "creditor_expense.edit": {
      "operation": "edit",
      "description": "Αλλαγή ήδη ανοικτού παραστατικού πιστωτή",
      "required_context": [
        "document_date",
        "document_number",
        "payment_method"
      ],
      "steps": [
        {
          "id": "existing-document-visible",
          "action": "assert",
          "selector": {
            "title_re": ".+ - \\d{1,2}/\\d{1,2}/\\d{4}",
            "control_type": "Text"
          }
        },
        {
          "id": "date",
          "action": "set",
          "selector": {
            "control_type": "Edit",
            "anchor": {
              "direction": "right",
              "max_distance": 500,
              "selector": {
                "title_re": "Ημερ/νία|Ημερομηνία"
              }
            }
          },
          "value": "{document_date}"
        },
        {
          "id": "document-number",
          "action": "set",
          "selector": {
            "control_type": "Edit",
            "anchor": {
              "direction": "right",
              "max_distance": 600,
              "selector": {
                "title_re": "Παραστατικό|Αρ\\. παραστατικού"
              }
            }
          },
          "value": "{document_number}"
        },
        {
          "id": "payment",
          "action": "set",
          "selector": {
            "control_type": "ComboBox",
            "anchor": {
              "direction": "right",
              "max_distance": 700,
              "selector": {
                "title": "Πληρωμή"
              }
            }
          },
          "value": "{payment_method}",
          "submit_keys": "{ENTER}"
        },
        {
          "id": "save",
          "action": "save",
          "selector": {
            "title": "Καταχώρηση",
            "control_type": "Button"
          }
        }
      ]
    }
  }
}
